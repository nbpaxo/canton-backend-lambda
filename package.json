{
  "name": "canton-backend-lambda",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:all": "concurrently -n api,watcher -c blue,green \"npm:dev\" \"npm:start:watcher\"",
    "build": "tsc && cp -r src/canton-sdk dist/canton-sdk",
    "start": "node dist/server.js",
    "start:watcher": "tsx --env-file=.env src/workers/depositWatcher.ts",
    "db:apply": "set -a && . ./.env 2>/dev/null || true && set +a && psql \"${DATABASE_URL:-postgres://canton_backend:canton_backend@localhost:5436/canton_backend}\" -f src/db/schema.sql",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.4.0"
  }
}
