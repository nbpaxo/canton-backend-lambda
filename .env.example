# canton-backend-lambda — devnet branch — example env.
# Copy to `.env` and fill in any blanks before `npm run dev`.
# Values below mirror /Users/neeraj/canton/exchange-v2/backend/.env where they overlap.

# ─── Canton Ledger (devnet validator) ────────────────────────────────────
CANTON_LEDGER_API=https://canton.56.69.6.174.nip.io

# Devnet validator namespace fingerprint — every party we allocate uses this.
PARTICIPANT_SUFFIX=12203171abe141f5537ded76661f4ff75b4fde178e950fca4193e2bb268e8238cfb2

# Daml package id of our DApp contracts (the operator-only-signed variant).
# Update once the new DAR is built + vetted on the validator.
PACKAGE_ID=__SET_AFTER_DAR_DEPLOY__

# ─── Keycloak (devnet) ──────────────────────────────────────────────────
KEYCLOAK_BASE=https://keycloak.56.69.6.174.nip.io
KEYCLOAK_REALM=AppProvider
KEYCLOAK_CLIENT_ID=app-provider-validator
KEYCLOAK_CLIENT_SECRET=

# Operator m2m credentials (used for operator-signed contract calls).
OPERATOR_KC_USERNAME=mperpoperator
OPERATOR_KC_PASSWORD=

# Token-issuer credentials. On devnet we ride Amulet (CC) issued by DSO,
# so this is the operator. On testnet/mainnet (custom token variant), swap.
CIRCLE_KC_USERNAME=mperpoperator
CIRCLE_KC_PASSWORD=

# ─── Managed party ids (mirrors exchange-v2 devnet allocation) ──────────
OPERATOR_PARTY_ID=mperpoperator::12203171abe141f5537ded76661f4ff75b4fde178e950fca4193e2bb268e8238cfb2
VAULT_POOL_PARTY_ID=mperpvaultpool::12203171abe141f5537ded76661f4ff75b4fde178e950fca4193e2bb268e8238cfb2
TREASURY_PARTY_ID=mperptreasury::12203171abe141f5537ded76661f4ff75b4fde178e950fca4193e2bb268e8238cfb2

# ─── Instrument (Amulet on devnet — frontend shows it as USDC) ──────────
INSTRUMENT_VARIANT=amulet
INSTRUMENT_ADMIN_PARTY_ID=DSO::1220be58c29e65de40bf273be1dc2b266d43a9a002ea5b18955aeef7aac881bb471a
INSTRUMENT_ID=Amulet
INSTRUMENT_SYMBOL=CC
INSTRUMENT_DECIMALS=10

# Scan / registry (CIP-56 token registry, transfer factory choice contexts).
REGISTRY_BASE_URL=https://vault.56.69.6.174.nip.io
SCAN_API_URL=https://scan.56.69.6.174.nip.io

# ─── Postgres ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://canton_backend:canton_backend@localhost:5436/canton_backend
PG_POOL_MAX=10

# ─── Auth mode ──────────────────────────────────────────────────────────
# 'open'      — accept x-party-id header without verification (DEV ONLY).
#               Set this while Loop users' auth path is still being designed.
# 'keycloak'  — require Keycloak JWT (production-ish, validator users only).
AUTH_MODE=open

# ─── Exchange backend (where Loop wallet auth happens) ──────────────────
# Reserved for the next phase — once exchange-backend exposes a JWKS / JWT
# we can flip AUTH_MODE off "open" and verify here.
EXCHANGE_BACKEND_URL=https://be.mperps.xyz

# ─── Persona Sandbox (KYC) ──────────────────────────────────────────────
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
PERSONA_TEMPLATE_ID=__GET_FROM_PERSONA_DASHBOARD__
PERSONA_ENVIRONMENT_ID=
PERSONA_API_BASE=https://withpersona.com/api/v1

# ─── CORS / runtime ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://testnet.mperps.xyz
ADMIN_API_KEY=canton-admin-secret-change-me
PORT=3003
